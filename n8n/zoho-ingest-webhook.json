      "parameters": {
        "jsCode": "const body = $json.body || $json || {};\n\n// form_id: prefira o query param da URL do webhook (?form_id=...).\nconst formId =\n  ($json.query && $json.query.form_id) ||\n  body.form_link_name ||\n  body.form_id ||\n  'CADASTRE_O_FORM_ID';\n\nfunction parseZohoDate(s) {\n  if (!s) return null;\n  const m = String(s).match(/(\\d{1,2})-([A-Za-z]{3})-(\\d{4})\\s+(\\d{1,2}):(\\d{2}):(\\d{2})/);\n  if (!m) return null;\n  const months = { Jan: 0, Feb: 1, Mar: 2, Apr: 3, May: 4, Jun: 5, Jul: 6, Aug: 7, Sep: 8, Oct: 9, Nov: 10, Dec: 11 };\n  return new Date(Date.UTC(+m[3], months[m[2]], +m[1], +m[4], +m[5], +m[6])).toISOString();\n}\n\nreturn [{\n  json: {\n    form_id: formId,\n    zoho_submission_id: null,\n    submitted_at: parseZohoDate(body.Added_Time || body.added_time),\n    payload: body,\n    source: 'webhook'\n  }\n}];"
      },
