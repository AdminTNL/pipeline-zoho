    {
      "parameters": {
        "jsCode": "const extract = $('Extract submission').first().json;\nconst payload = extract.payload || {};\nconst formId = extract.form_id;\n\n// 'Get form config' pode vir como objeto unico (json) ou array de linhas.\nlet fileFields = [];\nconst cfg = $json;\nif (Array.isArray(cfg)) {\n  fileFields = (cfg[0] && cfg[0].file_fields) || [];\n} else if (cfg && Array.isArray(cfg.file_fields)) {\n  fileFields = cfg.file_fields;\n}\n\n// extrai o file_id da URL do Google Drive\n// ex.: https://drive.google.com/file/d/<FILE_ID>/view?usp=drivesdk\nfunction extractFileId(url) {\n  const m = String(url).match(/\\/file\\/d\\/([^\\/?]+)/);\n  return m ? m[1] : null;\n}\n\nconst items = [];\nfor (const field of fileFields) {\n  const val = payload[field];\n  if (!val) continue;\n  const urls = Array.isArray(val) ? val : [val];\n  for (const url of urls) {\n    const fileId = extractFileId(url);\n    if (!fileId) continue;\n    items.push({\n      json: {\n        form_id: formId,\n        field: field,\n        file_id: fileId\n      }\n    });\n  }\n}\n\nreturn items;"
      },
